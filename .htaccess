# Sécurité : bloque l'accès aux fichiers et dossiers techniques
RedirectMatch 404 /\.
RedirectMatch 404 ^/(App|templates|tests|vendor|sql)/
RedirectMatch 404 ^/(composer\.json|composer\.lock|phpunit\.xml|docker-compose\.yml|Dockerfile|README\.md)$

RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

#accueil
RewriteRule ^$ index.php?controller=page&action=accueil [L]

#page statique
RewriteRule ^a-propos/?$ index.php?controller=page&action=about [L]

#page menus
RewriteRule ^menus/?$ index.php?controller=menu&action=menus [L]
RewriteRule ^menu/([0_9]+)/?$ index.php?controller=menu&action= [L]


